{
  "name": "mythoveya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mythoveya: Call of the Wildbound — a local 3D creature-collection RPG",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,game \"tsx watch apps/server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build && esbuild apps/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:audit": "tsx scripts/content-audit.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.17.51",
    "@colyseus/sdk": "0.17.43",
    "@colyseus/ws-transport": "0.17.13",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.3.0",
    "express": "5.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.3",
    "concurrently": "9.2.4",
    "esbuild": "0.25.10",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
